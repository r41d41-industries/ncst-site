# FTP (deploy only — not used by the PHP app at runtime)
FTP_ADDRESS=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# Database (local MariaDB or remote when PHP runs on the server)
DB_ADDRESS=localhost
DB_PORT=3306
DB_NAME=cowscan_
DB_USER=
DB_PASSWORD=
DB_TABLE_PREFIX=CS_

# App
SITE_URL=http://localhost:8080
SESSION_SECRET=change-me-to-a-long-random-string

# Admin account email (password resets + seed/migrate assignment)
ADMIN_EMAIL=contact@r41d41.com

# SMTP2GO (password reset mail)
SMTP2GO_API_KEY=
SMTP2GO_SENDER=NCST <noreply@example.com>
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send

# Facebook Page Graph API (admin Facebook Sync; can also be set in Settings UI)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v25.0

# Shared secret for /cron/facebook_sync.php HTTP triggers (CLI does not require it)
CRON_SECRET=

# Optional one-time seed hints (document only; prefer hashing in seed.sql)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=set-at-seed-time
